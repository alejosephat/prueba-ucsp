	/// VERDADERO si el programa pertenece a la UCSP. Para el filtro de pagina de la pregunta 4.3: el segmentador de universidad no llega a dim_programa porque las dimensiones no se relacionan entre si.
	column es_ucsp =
			-- Ayuda de presentacion: permite filtrar a nivel de pagina los programas de la
			-- UCSP. Se toma la marca de dim_universidad en vez de repetir el codigo INEI,
			-- asi el codigo vive en un solo lugar (config.py -> ref_parametros -> gold).
			LOOKUPVALUE ( dim_universidad[es_ucsp], dim_universidad[codigo_inei], dim_programa[codigo_inei] )
		dataType: boolean
		lineageTag: f8fc42ff-d939-425f-992f-07ebb93d0201

	partition dim_programa = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaGold & "dim_programa.parquet"))
				in
				    Origen

