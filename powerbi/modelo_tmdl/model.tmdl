/// Benchmark de oferta academica y matricula de pregrado. UCSP frente a la macrorregion sur y el pais. Fuente: SUNEDU / tuni.pe.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table dim_periodo
ref table dim_semestre
ref table dim_universidad
ref table dim_programa
ref table dim_ubicacion
ref table dim_tendencia_programa
ref table fct_ingresantes
ref table fct_matricula
ref table fct_postulantes
ref table fct_egresados
ref table fct_docentes
ref table fct_titulos
ref table fct_concentracion
ref table _Medidas

ref cultureInfo en-US

